.header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
}

.description {
    margin: 0;
    color: var(--default-secondary-text);
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 0 24px;
}

.refreshButton {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--default-main-text);
}

.nameCell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
}

.secondary {
    overflow: hidden;
    max-width: 320px;
    margin-top: 4px;
    color: var(--default-secondary-text);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.errorText {
    margin-top: 4px;
    color: var(--default-error-link);
}

.servers {
    display: block;
    overflow-wrap: anywhere;
    white-space: pre-line;
}

.empty {
    padding: 32px;
    color: var(--default-secondary-text);
    text-align: center;
}

.editorGrid {
    display: grid;
    gap: 32px;
    padding: 0 16px;

    @media (min-width: 1024px) {
        grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
        align-items: start;
        padding: 0;
    }
}

.editorMain {
    min-width: 0;
}

.back {
    margin-bottom: 16px;
    padding: 0;
    border: 0;
    background: transparent;
}

.ruleEditor {
    min-height: 460px;
    resize: vertical;
}

.editorActions {
    display: flex;
    padding-top: 16px;
}

.testCard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border-radius: 8px;
    background: var(--default-cards-background);
    box-shadow: 8px 8px 24px 0 var(--main-box-shadow);
}

.testResult {
    padding: 16px;
    border: 1px solid var(--default-item-divider);
    border-radius: 6px;
    background: var(--page-background-additional);
}
